{
  "name": "be-my-hand",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run --exclude \"tests/rules/**\"",
    "test:rules": "export JAVA_HOME=\"$(node scripts/java21-home.mjs)\" && export PATH=\"$JAVA_HOME/bin:$PATH\" && firebase emulators:exec --only firestore \"vitest run tests/rules --no-file-parallelism\" --project demo-be-my-hand",
    "emulators": "export JAVA_HOME=\"$(node scripts/java21-home.mjs)\" && export PATH=\"$JAVA_HOME/bin:$PATH\" && firebase emulators:start --only firestore,auth --project demo-be-my-hand",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "check:tokens": "node scripts/check-tokens.mjs",
    "data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data.mts"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@shopify/flash-list": "2.0.2",
    "babel-preset-expo": "~57.0.11",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "^57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.23",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.26",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^25.5.2",
    "libphonenumber-js": "^1.13.16",
    "lucide-react-native": "^1.45.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^15.7.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.2.4",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.30.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "expo-router@57.0.31": "patches/expo-router@57.0.31.patch"
    }
  }
}
