# Local scripts only (scripts/data.mts). Copy to .env.scripts, which is gitignored.
# Never commit real values. Nothing here is read by the app bundle.

# Shared Auth password for every seeded account. Required for a live seed (8+ characters).
# Per-account SEED_*_PASSWORD below overrides this when set.
SEED_PASSWORD=

# Platform owner (userType owner, every system key)
SEED_OWNER_EMAIL=ahmedsalihdev@gmail.com
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=

# Support (users.view, workspaces.view, logs.view; no chat)
SEED_SUPPORT_EMAIL=support@bemyhand.test
SEED_SUPPORT_NAME=
SEED_SUPPORT_PASSWORD=

# Moderator
SEED_MODERATOR_EMAIL=moderator@bemyhand.test
SEED_MODERATOR_NAME=
SEED_MODERATOR_PASSWORD=

# Workspace creator of seed-cairo (locked admin seat)
SEED_CEO_EMAIL=ceo@bemyhand.test
SEED_CEO_NAME=
SEED_CEO_PASSWORD=

# Workspace admin
SEED_ADMIN_EMAIL=admin@bemyhand.test
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# Workspace member
SEED_MEMBER_EMAIL=member@bemyhand.test
SEED_MEMBER_NAME=
SEED_MEMBER_PASSWORD=

# Custom field-operator role
SEED_FIELD_EMAIL=field@bemyhand.test
SEED_FIELD_NAME=
SEED_FIELD_PASSWORD=

# Approved supplier (no workspace)
SEED_SUPPLIER_EMAIL=supplier@bemyhand.test
SEED_SUPPLIER_NAME=
SEED_SUPPLIER_PASSWORD=

# Cloudinary API key and secret in one URL (cloud rrphuvne). Get it from the Cloudinary console,
# Settings, API keys. Used only by local scripts, never by the app.
# Format: cloudinary://<api_key>:<api_secret>@rrphuvne
CLOUDINARY_URL=

# Payment details written to supportMethods/instapay and supportMethods/vodafone-cash by
# `pnpm data -- --marketing --apply` (or --seed). A method stays hidden until it has a real value.
# INSTAPAY_LINK must be an https URL. Leave empty to keep the placeholders (or to reuse the values
# of an older appConfig/support document).
INSTAPAY_LINK=
INSTAPAY_ADDRESS=
VODAFONE_CASH_NUMBER=
