# Be My Hand environment. Copy to .env (gitignored). No secrets belong here:
# Firebase is configured natively from the google-services files below.
# The downloaded apps are project bemyhand-8de0e, package/bundle
# com.salihcodev.bemyhand on both Android and iOS. There is no .dev app,
# so APP_BUNDLE_ID must stay on that id or the native build will not find a client.

# development | production. Selects the default firebase/<env>/ folder
# when the GOOGLE_SERVICES_* paths below are unset.
APP_ENV=development

APP_NAME=Be My Hand
APP_SLUG=be-my-hand
APP_SCHEME=bemyhand
APP_BUNDLE_ID=com.salihcodev.bemyhand
GOOGLE_SERVICES_JSON=./firebase/dev/google-services.json
GOOGLE_SERVICES_PLIST=./firebase/dev/GoogleService-Info.plist

# Web client ID (oauth client_type 3) from google-services.json. Required for Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Connect a development build to local emulators (pnpm emulators).
# Android emulator: use 10.0.2.2 as the host.
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
