# Be My Hand environment. Copy to .env (gitignored). No secrets belong here:
# Firebase is configured natively from the google-services files below.
# The downloaded apps are project bemyhand-8de0e, package/bundle
# com.salihcodev.bemyhand on both Android and iOS. There is no .dev app,
# so APP_BUNDLE_ID must stay on that id or the native build will not find a client.

# development | production. Selects the default firebase/<env>/ folder
# when the GOOGLE_SERVICES_* paths below are unset.
APP_ENV=development

APP_NAME=Be My Hand
APP_SLUG=be-my-hand
APP_SCHEME=bemyhand
APP_BUNDLE_ID=com.salihcodev.bemyhand
GOOGLE_SERVICES_JSON=./firebase/dev/google-services.json
GOOGLE_SERVICES_PLIST=./firebase/dev/GoogleService-Info.plist

# Web client ID (oauth client_type 3) from google-services.json. Required for Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Cloudinary media (docs/cloudinary-setup.md). These are public by design:
# the cloud name is in every image URL, and an *unsigned* upload preset is
# meant to be used from clients. The API key and API secret are NOT here and
# must never be: they go only in .env.scripts (gitignored, local scripts only).
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=rrphuvne
# Prefix of the nine unsigned presets created in the Cloudinary console
# (bmh_avatars, bmh_banners, bmh_support, bmh_store, bmh_suppliers, bmh_bags, bmh_chat,
# bmh_beneficiaries, bmh_misc). Leave empty to disable uploads.
EXPO_PUBLIC_CLOUDINARY_PRESET_PREFIX=bmh_
EXPO_PUBLIC_CLOUDINARY_FOLDER=be-my-hand

# Host of shared join links (https://<host>/join?w=…&c=…). Changing it needs a new native
# build (iOS associated domains, Android intent filter) and the .well-known files on that host.
EXPO_PUBLIC_LINK_DOMAIN=bmyhand.vercel.app

# Connect a development build to local emulators (pnpm emulators).
# Android emulator: use 10.0.2.2 as the host.
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
