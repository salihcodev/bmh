{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "APP_BUNDLE_ID": "com.salihcodev.bemyhand",
        "APP_NAME": "Be My Hand"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_ENV": "development",
        "APP_BUNDLE_ID": "com.salihcodev.bemyhand",
        "APP_NAME": "Be My Hand"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "APP_BUNDLE_ID": "com.salihcodev.bemyhand",
        "APP_NAME": "Be My Hand"
      }
    }
  }
}
